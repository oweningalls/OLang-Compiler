<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>AssemblyGeneration</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\ErrorHelper\ErrorHelper.csproj" />
      <ProjectReference Include="..\OLangAst\OLangAst.csproj" />
      <ProjectReference Include="..\OLangHelpers\OLangHelpers.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Assets\runtimeconfigtemplate.json" />

        <ContentWithTargetPath Include="Assets\runtimeconfigtemplate.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>Assets\runtimeconfigtemplate.json</TargetPath>
        </ContentWithTargetPath>
    </ItemGroup>

</Project>
